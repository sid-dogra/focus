rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'dograsiddhant@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if isApprovedOwner(userId);

      match /{document=**} {
        allow read, write: if isApprovedOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
